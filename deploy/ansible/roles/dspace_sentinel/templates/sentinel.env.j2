# {{ ansible_managed }}
# Environment for DSpace Sentinel, read by the systemd unit (EnvironmentFile=) and by every
# ./sentinel.sh command. One KEY="VALUE" per line; the file may hold secrets (mode 0600).
{% for key, value in dspace_sentinel_env | dictsort %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
{% endfor %}
