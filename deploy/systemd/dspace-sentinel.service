# DSpace Sentinel — systemd unit template.
#
# `./sentinel.sh install --service` (or `python -m dspace_sentinel install-service`) replaces
# the @TOKENS@ below with the invoking user and the checkout's paths and installs the result as
# /etc/systemd/system/dspace-sentinel.service. With `--user-service` the same template becomes a
# `systemd --user` unit: User=/Group= and the namespace-based sandbox directives are dropped
# (a user manager may not create mount namespaces) and the unit is wanted by default.target.
# The Ansible role renders its own copy from roles/dspace_sentinel/templates/.
# Paths are double-quoted where systemd splits on whitespace (Environment=, ExecStart=,
# ReadWritePaths=) and every '%' is written as '%%', so a checkout such as
# "/srv/dspace tools/dspace-sentinel" works; WorkingDirectory= takes the path as it is.
#
# Sentinel only observes the machine: the sandbox below leaves the whole filesystem read-only
# except its own data directory (SQLite, reports, log) and its config directory.

[Unit]
Description=DSpace Sentinel — observe-only health dashboard for DSpace
Documentation=https://github.com/Danindu05/dspace-sentinel
After=network-online.target
Wants=network-online.target
# Restart=on-failure below retries a crash every 5 s; a config error that stops every start
# ends in "failed" after five tries (see `./sentinel.sh logs`) instead of looping forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
Environment="SENTINEL_DATA_DIR=@DATA_DIR@"
Environment="SENTINEL_CONFIG=@CONFIG_PATH@"
# Optional KEY=VALUE file for secrets (SENTINEL_TELEGRAM_TOKEN, SENTINEL_PG_PASSWORD,
# SENTINEL_AUTH_TOKEN, ...); ./sentinel.sh reads the same file in pid-file mode. Keep it 0600.
EnvironmentFile=-@CONFIG_DIR@/sentinel.env
ExecStart="@PYTHON@" -m dspace_sentinel serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
SyslogIdentifier=dspace-sentinel

# Footprint (SPEC §0.2): stay out of DSpace's way
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=300M

# Hardening (SPEC §11)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@DATA_DIR@" "@CONFIG_DIR@"
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=@WANTED_BY@
